{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "cpu-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HALO_GPU": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HALO_HRX_ROOT": "$env{HRX_ROOT}"
      }
    },
    {
      "name": "cpu-asan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HALO_SANITIZE": "address,undefined",
        "HALO_GPU": "OFF"
      }
    },
    {
      "name": "cpu-tsan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HALO_SANITIZE": "thread",
        "HALO_GPU": "OFF"
      }
    },
    {
      "name": "cpu-ubsan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HALO_SANITIZE": "undefined",
        "HALO_GPU": "OFF"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HALO_FUZZ": "ON",
        "HALO_BUILD_TESTS": "OFF",
        "HALO_GPU": "OFF"
      }
    },
    {
      "name": "gpu",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HALO_GPU": "ON",
        "HALO_HRX_ROOT": "$env{HRX_ROOT}"
      }
    },
    {
      "name": "mull",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HALO_GPU": "OFF",
        "CMAKE_C_FLAGS": "-O0 -g -grecord-command-line -fpass-plugin=$env{MULL_ROOT}/usr/lib/mull-ir-frontend-21",
        "CMAKE_CXX_FLAGS": "-O0 -g -grecord-command-line -fpass-plugin=$env{MULL_ROOT}/usr/lib/mull-ir-frontend-21"
      },
      "environment": {
        "MULL_CONFIG": "${sourceDir}/mull.yml"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cpu-asan",
      "configurePreset": "cpu-asan"
    },
    {
      "name": "cpu-tsan",
      "configurePreset": "cpu-tsan"
    },
    {
      "name": "cpu-ubsan",
      "configurePreset": "cpu-ubsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "gpu",
      "configurePreset": "gpu"
    },
    {
      "name": "mull",
      "configurePreset": "mull"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-asan",
      "configurePreset": "cpu-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "cpu-tsan",
      "configurePreset": "cpu-tsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "cpu-ubsan",
      "configurePreset": "cpu-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "gpu",
      "configurePreset": "gpu",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
