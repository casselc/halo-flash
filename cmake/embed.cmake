# Embeds a binary file as a C++ byte array: -DINPUT -DOUTPUT_CPP -DOUTPUT_HPP -DNAME
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR bytes "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
file(WRITE "${OUTPUT_CPP}" "// Generated from ${NAME}.hsaco by cmake/embed.cmake.\n#include \"kernels/${NAME}_hsaco.hpp\"\nnamespace halo::kernels {\nnamespace { alignas(64) const unsigned char kData[] = {${body}}; }\nstd::span<const std::uint8_t> ${FUNC}() { return {kData, ${bytes}}; }\n}\n")
file(WRITE "${OUTPUT_HPP}" "// Generated by cmake/embed.cmake.\n#pragma once\n#include <cstdint>\n#include <span>\nnamespace halo::kernels { std::span<const std::uint8_t> ${FUNC}(); }\n")
