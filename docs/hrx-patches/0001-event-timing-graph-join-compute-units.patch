diff --git a/libhrx/src/libhrx/event.c b/libhrx/src/libhrx/event.c
index 57f6c11d7b..b22a8d42b1 100644
--- a/libhrx/src/libhrx/event.c
+++ b/libhrx/src/libhrx/event.c
@@ -41,6 +41,31 @@ hrx_status_t hrx_event_create(hrx_device_t device, hrx_event_flags_t flags,
     return status;
   }
 
+  // Timed events capture a device tick at the record point when the device
+  // publishes a timestamp domain.
+  const iree_hal_device_timing_spec_t* timing =
+      iree_hal_device_spec_timing(iree_hal_device_spec(device->hal_device));
+  if (!(flags & HRX_EVENT_FLAG_DISABLE_TIMING) &&
+      iree_all_bits_set(timing->flags,
+                        IREE_HAL_DEVICE_TIMING_SPEC_FLAG_DEVICE_TIMESTAMPS)) {
+    iree_hal_buffer_params_t params = {0};
+    params.type = IREE_HAL_MEMORY_TYPE_HOST_LOCAL |
+                  IREE_HAL_MEMORY_TYPE_DEVICE_VISIBLE |
+                  IREE_HAL_MEMORY_TYPE_HOST_COHERENT;
+    params.usage =
+        IREE_HAL_BUFFER_USAGE_TRANSFER | IREE_HAL_BUFFER_USAGE_MAPPING;
+    params.access = IREE_HAL_MEMORY_ACCESS_ALL;
+    params.queue_family_affinity = IREE_HAL_QUEUE_FAMILY_AFFINITY_ANY;
+    iree_status_t iree_status = iree_hal_allocator_allocate_buffer(
+        device->allocator.hal_allocator, params, sizeof(uint64_t),
+        &event->timestamp_buffer);
+    if (!iree_status_is_ok(iree_status)) {
+      hrx_semaphore_release(event->semaphore);
+      free(event);
+      return hrx_status_from_iree(iree_status);
+    }
+  }
+
   *out_event = event;
   return hrx_ok_status();
 }
@@ -59,6 +84,7 @@ void hrx_event_release(hrx_event_t event) {
   if (iree_atomic_ref_count_dec(&event->ref_count) == 1) {
     hrx_semaphore_release(event->semaphore);
     hrx_stream_release(event->recording_stream);
+    iree_hal_buffer_release(event->timestamp_buffer);
     free(event);
   }
 }
@@ -111,12 +137,28 @@ hrx_status_t hrx_event_record(hrx_event_t event, hrx_stream_t stream) {
       .payload_values = sig_vals,
   };
 
+  // A timed event writes the device tick at the point everything before it on
+  // the stream has completed; the host clock read above only says when the
+  // record was enqueued.
+  const iree_hal_queue_family_spec_t* family =
+      iree_hal_queue_family_spec(iree_hal_queue_family(stream->hal_queue));
+  const bool captures_tick = event->timestamp_buffer &&
+                             family->timestamp_frequency_hz != 0 &&
+                             family->timestamp_valid_bits != 0 &&
+                             family->timestamp_valid_bits <= 64;
   iree_status_t iree_status =
-      iree_hal_queue_barrier(stream->hal_queue, wait_list, signal_list,
-                             IREE_HAL_QUEUE_BARRIER_FLAG_NONE);
+      captures_tick
+          ? iree_hal_queue_timestamp(stream->hal_queue, wait_list, signal_list,
+                                     event->timestamp_buffer, 0,
+                                     IREE_HAL_TIMESTAMP_FLAG_NONE)
+          : iree_hal_queue_barrier(stream->hal_queue, wait_list, signal_list,
+                                   IREE_HAL_QUEUE_BARRIER_FLAG_NONE);
   if (!iree_status_is_ok(iree_status)) {
     return hrx_status_from_iree(iree_status);
   }
+  event->timestamp_frequency_hz =
+      captures_tick ? family->timestamp_frequency_hz : 0;
+  event->timestamp_valid_bits = captures_tick ? family->timestamp_valid_bits : 0;
 
   return hrx_ok_status();
 }
@@ -191,6 +233,35 @@ hrx_status_t hrx_event_elapsed_time(hrx_event_t start, hrx_event_t stop,
                            "stop event has not completed");
   }
 
+  if (start->timestamp_frequency_hz != 0 || stop->timestamp_frequency_hz != 0) {
+    if (start->timestamp_frequency_hz != stop->timestamp_frequency_hz ||
+        start->timestamp_valid_bits != stop->timestamp_valid_bits) {
+      return hrx_make_status(
+          HRX_STATUS_INVALID_ARGUMENT,
+          "events were recorded in different timestamp domains");
+    }
+    uint64_t start_tick = 0, stop_tick = 0;
+    iree_status_t iree_status = iree_hal_buffer_map_read(
+        start->timestamp_buffer, 0, &start_tick, sizeof(start_tick));
+    if (iree_status_is_ok(iree_status)) {
+      iree_status = iree_hal_buffer_map_read(stop->timestamp_buffer, 0,
+                                             &stop_tick, sizeof(stop_tick));
+    }
+    if (!iree_status_is_ok(iree_status)) {
+      return hrx_status_from_iree(iree_status);
+    }
+    const uint32_t bits = start->timestamp_valid_bits;
+    const uint64_t mask = bits == 64 ? UINT64_MAX : ((1ull << bits) - 1ull);
+    const uint64_t delta = (stop_tick - start_tick) & mask;
+    const uint64_t sign_bit = (mask >> 1) + 1ull;
+    const double signed_delta =
+        delta >= sign_bit ? -(double)(mask - delta) - 1.0 : (double)delta;
+    *ms = (float)(signed_delta * 1000.0 /
+                  (double)start->timestamp_frequency_hz);
+    return hrx_ok_status();
+  }
+
+  // No device timestamp domain: fall back to host enqueue times.
   int64_t elapsed_ns = stop->record_time_ns - start->record_time_ns;
   *ms = (float)elapsed_ns / 1000000.0f;
   return hrx_ok_status();
